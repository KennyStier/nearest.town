# Example systemd unit. Copy to /etc/systemd/system/, adjust paths, then:
#   sudo systemctl enable --now nearest-town-api
# Check the sandboxing score with: systemd-analyze security nearest-town-api
[Unit]
Description=Nearest Town API
After=network.target

[Service]
WorkingDirectory=/opt/nearest.town/api
ExecStart=/usr/bin/node server.mjs
Environment=NODE_ENV=production
Environment=PORT=8080
Environment=HOST=127.0.0.1
# Behind a reverse proxy on this machine, rate-limit by the real client IP:
Environment=TRUST_PROXY=1
Environment=RATE_LIMIT_PER_MIN=600
Restart=on-failure
RestartSec=2

# Run as a throwaway user with no home, shell, or write access anywhere.
DynamicUser=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
UMask=0077
# Node's JIT needs writable+executable memory, so MemoryDenyWriteExecute stays off.
MemoryMax=512M
TasksMax=64
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
